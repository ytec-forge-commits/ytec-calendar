{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Y-TEC Calendar",
  "version": "0.1.2",
  "identifier": "jp.ytec.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Y-TEC Calendar",
        "width": 960,
        "height": 620,
        "minWidth": 375,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
